# Every variable is optional in development. Copy to .env and fill in what you need.

# Enables the Claude interviewer and synthesis. Unset means scripted mode (fixed questions).
ANTHROPIC_API_KEY=
# Model for every AI call.
UNITE_MODEL=claude-opus-5-5
# Spending caps in US dollars. Over a cap means scripted mode until the next day or month.
UNITE_AI_DAILY_USD=5
UNITE_AI_MONTHLY_USD=40
# Postgres. Unset means PGlite at UNITE_DATA_DIR (default redesign/.data), or in memory with UNITE_DATA_DIR=memory.
DATABASE_URL=
UNITE_DATA_DIR=
# Signs the session cookie. Required in production.
UNITE_SECRET=
# Passcodes for the host and steward consoles: host and steward in development; required in production.
UNITE_HOST_CODE=
UNITE_STEWARD_CODE=
# Seeds the examples on an empty store and shows the role switcher. 1 in development.
UNITE_DEMO=1
# Fixed clock (ISO date-time) for tests and the video, for example 2026-11-13T09:00:00Z.
UNITE_NOW=
# Server port (the web dev server runs on 4311 and proxies /api here).
PORT=4310
