{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @unite/web build",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "claude/unite-showcase": true
    }
  },
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{apps/server/src/**,apps/server/package.json,apps/server/tsconfig.json,apps/server/vercel-entry.mjs,packages/shared/src/**,packages/shared/package.json,packages/shared/vercel-trace.mjs,packages/shared/tsconfig.json,tsconfig.base.json,RELEASES.json,node_modules/.pnpm/@electric-sql+pglite@*/node_modules/@electric-sql/pglite/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/((?!api/|healthz|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
