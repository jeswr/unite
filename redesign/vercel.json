{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @unite/web build",
  "outputDirectory": "apps/web/dist",
  "git": { "deploymentEnabled": false },
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{apps/server/src/**,apps/server/package.json,apps/server/vercel-entry.mjs,packages/shared/src/**,packages/shared/package.json,tsconfig.base.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/healthz", "destination": "/api/index.mjs" },
    { "source": "/((?!api/|healthz|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
